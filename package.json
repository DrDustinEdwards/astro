{
  "name": "astro-packages",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/enarratio-astro",
    "packages/enarratio-emdash"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/markdown-satteri": "0.4.5",
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.0",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "satteri": "0.10.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
