{
  "name": "astro-packages",
  "private": true,
  "workspaces": [
    "packages/enarratio-astro",
    "packages/enarratio-emdash"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm run lint && npm test",
    "bloat": "devkit-no-bloat"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@astrojs/markdown-remark": "7.3.7",
    "@astrojs/markdown-satteri": "0.4.8",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.50.1",
    "@types/node": "26.6.6",
    "astro": "7.4.10",
    "emdash": "1.4.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
