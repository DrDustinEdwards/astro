{
  "name": "enarratio-emdash",
  "version": "0.1.0",
  "description": "EmDash plugin: a Chart block for the Portable Text editor, drawn on the server by Enarratio as accessible HTML and SVG",
  "keywords": [
    "emdash",
    "emdash-plugin",
    "astro",
    "charts",
    "accessibility",
    "enarratio"
  ],
  "homepage": "https://github.com/DrDustinEdwards/enarratio-emdash#readme",
  "bugs": {
    "url": "https://github.com/DrDustinEdwards/enarratio-emdash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrDustinEdwards/enarratio-emdash.git"
  },
  "license": "MIT",
  "author": "Dustin Edwards (https://dustinedwards.info)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": "./src/astro/index.ts",
    "./astro/base": "./src/astro/base.ts",
    "./astro/none": "./src/astro/none.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "astro": ">=6.0.0",
    "emdash": ">=1.0.0"
  },
  "dependencies": {
    "@observablehq/plot": "0.6.17",
    "enarratio": "0.3.1",
    "linkedom": "0.18.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.0",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
