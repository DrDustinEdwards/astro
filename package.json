{
  "name": "astro-packages",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/enarratio-astro",
    "packages/enarratio-emdash"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm run lint && npm test",
    "bloat": "devkit-no-bloat"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/markdown-satteri": "0.4.6",
    "@biomejs/biome": "2.6.4",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.21.0",
    "@types/node": "22.20.5",
    "astro": "7.4.4",
    "emdash": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
