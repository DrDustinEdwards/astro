{
  "name": "enarratio-emdash-demo",
  "private": true,
  "description": "A small EmDash site that renders every kind of chart: EmDash blocks, the Astro component and Markdown. For screenshots and the packaging check in CI",
  "type": "module",
  "scripts": {
    "setup": "emdash init && emdash seed seed/seed.json --on-conflict=update",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.12",
    "@astrojs/react": "7.1.2",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "astro": "7.4.4",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.87.0",
    "emdash": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "0.4.6"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "emdash": {
    "seed": "seed/seed.json"
  }
}
