---
/**
 * Renders a saved Chart block. EmDash passes the block as `node`; the plugin's `styles` option
 * picks the entry (astro, astro/base, astro/none) and so the `styles` prop. A site can also wrap
 * this component to pass its own Enarratio theme, and register the wrapper through
 * `<PortableText components={{ type: { enarratioChart: MyChart } }}>`.
 */
import {
  baseStylesheet,
  type StylesheetOptions,
  type Theme,
  stylesheet as themeStylesheet,
} from "enarratio";
import { defaultTheme } from "enarratio/themes";
import { type ChartNode, renderChart } from "../chart.ts";
import Enhance from "./Enhance.astro";
import { firstOnPage } from "./once.ts";

interface Props {
  node: ChartNode;
  /** The Enarratio theme for this page's charts. Default: Enarratio's default theme. */
  theme?: Theme;
  /** Passed to Enarratio's `stylesheet()`, e.g. `{ colorScheme: { dark: '[data-theme="dark"]' } }`. */
  stylesheetOptions?: StylesheetOptions;
  /**
   * The CSS written once per page: `"theme"` (default) the theme's colors and Enarratio's rules;
   * `"base"` the rules only, for a site that defines the `--enarratio-*` colors and fonts in its
   * own tokens (Capsomer does); `"none"` nothing, for a site that includes Enarratio's CSS itself.
   */
  styles?: "theme" | "base" | "none";
}

const { node, theme = defaultTheme, stylesheetOptions, styles = "theme" } = Astro.props;
const result = await renderChart(node);
const css =
  styles !== "none" && firstOnPage(Astro.request)
    ? styles === "base"
      ? baseStylesheet()
      : themeStylesheet(theme, stylesheetOptions)
    : "";
// The note that replaces a chart that cannot be drawn, set apart from the article's own text.
const noteCss =
  ".enarratio-emdash-error{border-inline-start:3px solid currentColor;padding-inline-start:.75em;font-size:.875em}";
const interactive = result.ok && node.interactive === true;
if (!result.ok)
  console.warn(`[enarratio-emdash] chart ${node._key ?? ""} not drawn: ${result.error}`);
---

{css && <style is:inline set:html={`${css}\n${noteCss}`} />}
{
  result.ok ? (
    <div class="enarratio-emdash" data-enarratio-emdash-interactive={interactive ? "" : undefined} set:html={result.html} />
  ) : (
    <p class="enarratio-emdash-error" role="note">This chart could not be drawn. {result.error}</p>
  )
}
{interactive && <Enhance />}
